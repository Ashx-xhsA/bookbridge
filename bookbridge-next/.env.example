# BookBridge web app (Next.js) — example env file
# Copy to `.env.local` and fill in real values. Real env files are gitignored.

DATABASE_URL=postgresql://user:password@localhost:5432/bookbridge
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Python Worker (server-side only; the browser never calls it)
WORKER_URL=http://localhost:8000
# Same shared secret as the Worker's WORKER_CALLBACK_SECRET
WORKER_CALLBACK_SECRET=

# Encrypts users' model API keys at rest (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different value per environment, and keep it: rotating it makes every
# saved key undecryptable (users would have to re-enter theirs).
API_KEY_ENCRYPTION_KEY=
