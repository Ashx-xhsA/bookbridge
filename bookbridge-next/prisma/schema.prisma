generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  name          String?
  role          Role      @default(TRANSLATOR)
  apiKey        String?
  apiProvider   String?   @default("openai")
  apiBaseUrl    String?
  freeCharsUsed Int       @default(0)
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  TRANSLATOR
  REVIEWER
  ADMIN
}

model Project {
  id          String           @id @default(cuid())
  title       String
  sourceFile  String
  sourceLang  String           @default("en")
  targetLang  String           @default("zh-Hans")
  status      ProjectStatus    @default(DRAFT)
  isPublic    Boolean          @default(false)
  publicToken String?          @unique
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [clerkId])
  chapters    Chapter[]
  jobs        TranslationJob[]
  glossary    GlossaryTerm[]
  bible       BookBible?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum ProjectStatus {
  DRAFT
  PARSING
  READY
  TRANSLATING
  COMPLETED
}

model Chapter {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  summary   String?   @db.Text
  segments  Segment[]
}

// One source paragraph — the unit of translation. Source and translation
// text live only here (not on Chapter).
model Segment {
  id          String  @id @default(cuid())
  chapterId   String
  chapter     Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  index       Int
  source      String  @db.Text
  translation String? @db.Text
  status      String  @default("pending") // pending | translated | reviewed | failed

  @@unique([chapterId, index])
}

model TranslationJob {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId         String?
  status            JobStatus @default(QUEUED)
  workerId          String?
  result            String?   @db.Text
  translatedContent String?   @db.Text
  error             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  PENDING
  RUNNING
  SUCCEEDED
}

model GlossaryTerm {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  english     String
  translation String?
  category    String         @default("general")
  notes       String?
  approved    Boolean        @default(false)
  userEdited  Boolean        @default(false)
  // Book-bible fields (people mostly): pronouns/gender and how they speak.
  gender      String?
  voice       String?        @db.Text
  // Paragraphs naming this term or one of its aliases, from the pre-scan.
  mentions    Int            @default(0)
  // An alias ("Mithrandir") is its own term with its own fixed translation,
  // pointing at the entity it names (Gandalf). The model is told who is meant
  // but translates the alias as written.
  aliasOfId   String?
  aliasOf     GlossaryTerm?  @relation("Alias", fields: [aliasOfId], references: [id], onDelete: SetNull)
  aliases     GlossaryTerm[] @relation("Alias")

  @@index([aliasOfId])
}

// Whole-book context from the pre-scan: the style guide plus review and
// scan state. Characters, places and their aliases live in GlossaryTerm.
// Review status and scan status are separate so a re-scan (running or
// failed) never takes the current bible out of use.
model BookBible {
  id               String      @id @default(cuid())
  projectId        String      @unique
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  styleGuide       String      @default("") @db.Text
  // Set when the user edits the style guide; a re-scan then keeps it.
  styleGuideEdited Boolean     @default(false)
  status           BibleStatus @default(NONE)
  scanStatus       ScanStatus  @default(IDLE)
  scanStartedAt    DateTime?
  // TranslationJob row used to poll the latest scan (chapterId is null).
  jobId            String?
  updatedAt        DateTime    @updatedAt
}

// Review state: nothing drafted yet, drafted by a scan, or confirmed.
enum BibleStatus {
  NONE
  DRAFT
  CONFIRMED
}

enum ScanStatus {
  IDLE
  SCANNING
  FAILED
}
