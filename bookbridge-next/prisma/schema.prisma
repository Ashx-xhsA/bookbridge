generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  name          String?
  role          Role      @default(TRANSLATOR)
  apiKey        String?
  apiProvider   String?   @default("openai")
  apiBaseUrl    String?
  freeCharsUsed Int       @default(0)
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  TRANSLATOR
  REVIEWER
  ADMIN
}

model Project {
  id          String           @id @default(cuid())
  title       String
  sourceFile  String
  sourceLang  String           @default("en")
  targetLang  String           @default("zh-Hans")
  status      ProjectStatus    @default(DRAFT)
  isPublic    Boolean          @default(false)
  publicToken String?          @unique
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [clerkId])
  chapters    Chapter[]
  jobs        TranslationJob[]
  glossary    GlossaryTerm[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum ProjectStatus {
  DRAFT
  PARSING
  READY
  TRANSLATING
  COMPLETED
}

model Chapter {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  // Chapter-level translation from the v1 pipeline. Phase 2 translates per
  // Segment and this column goes away.
  translation String?   @db.Text
  summary     String?   @db.Text
  segments    Segment[]
}

// One source paragraph. Source text lives only here (not on Chapter).
model Segment {
  id          String  @id @default(cuid())
  chapterId   String
  chapter     Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  index       Int
  source      String  @db.Text
  translation String? @db.Text
  status      String  @default("pending") // pending | translated | reviewed | failed

  @@unique([chapterId, index])
}

model TranslationJob {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId         String?
  status            JobStatus @default(QUEUED)
  workerId          String?
  result            String?   @db.Text
  translatedContent String?   @db.Text
  error             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  PENDING
  RUNNING
  SUCCEEDED
}

model GlossaryTerm {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  english     String
  translation String?
  category    String  @default("general")
  notes       String?
  approved    Boolean @default(false)
  userEdited  Boolean @default(false)
}
